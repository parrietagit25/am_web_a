# ============================================================================
#  .env.example — Variables de entorno del paquete handoff
# ============================================================================
#
#  USO
#    1) Copia este archivo como .env  (mismo directorio).
#    2) Reemplaza cada __PUT_*__ con el valor real. El admin de Automarket te
#       entrega PARTNER_API_USER y PARTNER_API_PASS por canal seguro (1Password
#       o mensaje directo cifrado) — NO viajan en este zip por política
#       interna + Ley 81 de PA sobre protección de datos.
#    3) Ejecuta:
#         php 03-cliente-php-endpoint/sample-php-client.php PTY PTY 2026-06-01 10:00 2026-06-03 10:00 25
#
#  POLÍTICA DE SEGURIDAD
#    - Este archivo (.env.example) puede compartirse.
#    - El archivo .env REAL nunca se commitea ni se manda por correo abierto.
#    - Si por error compartes el .env real, rota credenciales con el admin.
# ============================================================================


# ─── Endpoint partner del backend Automarket ─────────────────────────────────
# URL base de tu backend en DigitalOcean App Platform.
PARTNER_API_BASE_URL=https://automarket-rentacar-fme3z.ondigitalocean.app

# Credenciales HTTP Basic Auth para el endpoint /api/partner/availability.
# Te las entrega el admin por canal seguro.
PARTNER_API_USER=__PUT_PARTNER_API_USER_HERE__
PARTNER_API_PASS=__PUT_PARTNER_API_PASS_HERE__


# ─── (Opcional) Mini-caché de tu sitio PHP ───────────────────────────────────
# Si vas a cachear las responses del endpoint para no atacarlo en cada page-load,
# define el TTL en segundos. Sugerencia: 300 (5 min) para balance entre fresqueza
# y carga al endpoint.
PHP_LOCAL_CACHE_TTL=300


# ─── Notas adicionales ───────────────────────────────────────────────────────
# - El sistema Node actual usa más variables (BARS_*, SUPABASE_*, ADMIN_KEY,
#   SYNC_KEY, N8N_*, etc.). Esas son del backend, no del cliente PHP. Tú no
#   necesitas ninguna de ellas — el endpoint partner las usa internamente.
# - Si en el futuro necesitas hablar SOAP directo a BARS (en lugar del endpoint),
#   pídele al admin un handoff aparte con credenciales BARS_USER/BARS_PASS/etc.
