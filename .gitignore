# Configuración local / secretos (crear en el servidor, no subir a Git)
app/config/config.php
app/services/Database.php
# Contenido dinámico del sitio (solo en cada servidor; ver app/storage/README.md)
app/storage/site_data.json
app/storage/site_data.json.bak*
# Plantilla vacía sí se versiona: app/storage/site_data.example.json

# Base SQLite local (reservas RAC, etc. — cada servidor tiene la suya)
app/storage/database.sqlite
app/storage/database.sqlite-*
app/storage/cache/

# Logs de aplicación
app/storage/logs/
*.log

# Variables de entorno locales
.env

# Sistema / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
