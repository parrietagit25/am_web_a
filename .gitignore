# Configuración local / secretos (crear en el servidor, no subir a Git)
app/config/config.php

# Contenido dinámico del sitio (se edita en admin en cada entorno; no versionar en Git)
app/storage/site_data.json
app/storage/site_data.json.bak*

# Base SQLite local (reservas RAC, etc. — cada servidor tiene la suya)
app/storage/database.sqlite
app/storage/database.sqlite-*
app/storage/cache/

# Logs de aplicación
app/storage/logs/
*.log

# Variables de entorno locales
.env

# Sistema / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
