# OPCIONAL — no es obligatorio para docker compose.
# Lo habitual en este proyecto es definir las variables en app/config/config.php
#
# Si prefieres .env: cp .env.example .env y completa los valores (no subir .env a Git)
N8N_SEMINUEVOS_WEBHOOK_URL=https://n8n.grupopcr.com.pa/webhook/seminuevos
N8N_SEMINUEVOS_JWT_SECRET=

N8N_AMCORP_WEBHOOK_URL=https://n8n.grupopcr.com.pa/webhook/amcorp-lead
N8N_AMCORP_JWT_SECRET=

N8N_RENTING_WEBHOOK_URL=https://n8n.grupopcr.com.pa/webhook/renting
N8N_RENTING_JWT_SECRET=

# MariaDB (contenedor "db", agregado en DB1B-1A). Solo usadas por docker-compose
# para crear el contenedor; la app sigue usando SQLite hasta activar DB_HOST
# en app/config/config.php. No commitear valores reales en .env.
DB_NAME=automarket
DB_USER=automarket_app
DB_PASS=change_me
DB_ROOT_PASSWORD=change_me_root
